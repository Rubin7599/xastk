{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rubin7599/xastk/schemas/result-v1.schema.json",
  "title": "xastk EXAFS fit result, version 1",
  "type": "object",
  "required": ["schema", "sample", "created", "software", "fit", "variables", "datasets"],
  "$defs": {
    "valerr": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "stderr": {"type": ["number", "null"]},
        "expr": {"type": "string"},
        "init": {"type": ["number", "null"]},
        "convention": {"type": "string"}
      }
    }
  },
  "properties": {
    "schema": {"const": "xastk-result/1"},
    "sample": {"type": "string"},
    "created": {"type": "string"},
    "software": {
      "type": "object",
      "required": ["xastk", "python"],
      "additionalProperties": {"type": "string"}
    },
    "fit": {
      "type": "object",
      "required": ["n_idp", "n_var", "chi_square", "chi2_reduced", "r_factor"],
      "properties": {
        "n_idp": {"type": "number"},
        "n_var": {"type": "integer"},
        "n_data": {"type": "integer"},
        "chi_square": {"type": "number"},
        "chi2_reduced": {"type": "number"},
        "r_factor": {"type": "number"},
        "aic": {"type": ["number", "null"]},
        "bic": {"type": ["number", "null"]}
      }
    },
    "s02_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/valerr"}]},
    "variables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valerr"}},
    "correlations": {"type": "object", "additionalProperties": {"type": "number", "minimum": -1, "maximum": 1}},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transform", "paths"],
        "properties": {
          "label": {"type": "string"},
          "n_idp": {"type": "number"},
          "transform": {
            "type": "object",
            "required": ["kmin", "kmax", "rmin", "rmax", "kweight"],
            "properties": {
              "kmin": {"type": "number"}, "kmax": {"type": "number"},
              "rmin": {"type": "number"}, "rmax": {"type": "number"},
              "kweight": {"type": "array", "items": {"type": "number"}},
              "dk": {"type": "number"}, "window": {"type": "string"}, "fitspace": {"type": "string"}
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "degen", "reff", "params", "r", "cn"],
              "properties": {
                "label": {"type": "string"},
                "filename": {"type": "string"},
                "degen": {"type": "number"},
                "reff": {"type": "number"},
                "nleg": {"type": "integer"},
                "geometry": {"type": "string"},
                "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valerr"}},
                "r": {"$ref": "#/$defs/valerr"},
                "cn": {"$ref": "#/$defs/valerr"}
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {"type": "object", "required": ["path", "sha256"],
                    "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
